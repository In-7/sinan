# Auto detect text files and normalize line endings to LF (UTF-8).
# Prevents any CRLF/charset mis-handling when git checks files in/out.
* text=auto eol=lf

# Binary assets must never be re-encoded or have line endings touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.pdf binary
*.zip binary
*.gz binary
*.dll binary
*.so binary
*.exe binary
